<div id="result-view" class="round-view cg-result" hidden>
    <p id="player-answer" class="cg-kicker"></p>
    <h1 id="answer-result" class="cg-display"></h1>

    <div class="cg-gain">
        <span id="result-gain" class="cg-gain-value"></span>
        <span class="cg-gain-unit">pts</span>
    </div>

    <div class="cg-stats">
        <div><span class="cg-meta-label">Place</span><span id="place" class="cg-meta-value"></span></div>
        <div><span class="cg-meta-label">Total</span><span id="score" class="cg-meta-value"></span></div>
    </div>
</div>
