<div id="time-up-view" class="round-view cg-result is-wrong" hidden>
    <p class="cg-kicker">No answer sent</p>
    <h1 class="cg-display">TIME'S UP</h1>

    <div class="cg-gain">
        <span class="cg-gain-value">+0</span>
        <span class="cg-gain-unit">pts</span>
    </div>

    <div class="cg-stats">
        <div><span class="cg-meta-label">Place</span><span id="timeup-place" class="cg-meta-value">…</span></div>
        <div><span class="cg-meta-label">Total</span><span id="timeup-score" class="cg-meta-value">…</span></div>
        <p class="cg-stats-note">Too slow this time. Get ready for the next question.</p>
    </div>
</div>
