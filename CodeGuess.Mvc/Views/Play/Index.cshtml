@model JoinGameViewModel

@if (TempData["Error"] != null)
{
    <p class="text-danger">@TempData["Error"]</p>
}

<form asp-controller="Play" asp-action="Join" method="post">

    <div>
        <input asp-for="JoinCode" placeholder="Game code" />
        <span asp-validation-for="JoinCode"
              class="text-danger"></span>
    </div>
   
    
    <div>
        <input asp-for="Nickname" placeholder="Nickname"/>
        <span asp-validation-for="Nickname"
              class="text-danger"></span>
    </div>
   
    
    <button type="submit">Join</button>

</form>