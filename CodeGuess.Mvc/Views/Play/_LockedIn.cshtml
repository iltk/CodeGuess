<div id="submitted-view" class="round-view cg-scene" hidden>
    @* filled by JS with a copy of the chosen button's letter + code *@
    <div id="submitted-letter" class="cg-option cg-option-locked" aria-hidden="true"></div>

    <div class="cg-locked-head">
        <h1 class="cg-display">LOCKED IN</h1>
        <p id="submitted-answer" class="cg-hint"></p>
    </div>

    <div class="cg-block" role="status">
        <div class="cg-row-label">
            <span>Waiting for the timer<span class="cg-dots" aria-hidden="true"></span></span>
            <span class="text-muted-cg">Answer saved</span>
        </div>
        <partial name="_BinaryBar" />
        <p class="cg-hint">Eyes on the big screen for the reveal.</p>
    </div>
</div>
