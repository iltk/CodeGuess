<div id="game" data-join-code="@ViewData["JoinCode"]">

    <div id="lobby-section" class="tab-content d-block">
        <h2>Lobby section</h2>
    </div>

    <div id="question-section" class="tab-content d-none">
        <h2>Question section</h2>
    </div>

    <div id="correctQuestion-section" class="tab-content d-none">
        <h2>Correct question is</h2>
    </div>

    <div id="result-section" class="tab-content d-none">
        <h2>Result section</h2>
    </div>


</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script src="~/js/play.js" asp-append-version="true"></script>
}
