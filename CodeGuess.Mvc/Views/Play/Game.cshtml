@model PlayGameViewModel

<div id="game" class="flex-grow-1 d-flex flex-column justify-content-center align-items-center" data-join-code="@Model.JoinCode" data-player-id="@Model.PlayerId">

    <partial name="_Lobby" />

    @* w-100: #game centres its children, which would shrink this wrapper to its content's width *@
    <div id="in-progress-section" class="tab-content w-100" hidden>
        <partial name="_GetReady"/>
        <partial name="_Answering"/>
        <partial name="_LockedIn"/>
        <partial name="_Result"/>
        <partial name="_TimeUp"/>
    </div>

    <partial name="_Finished" />

</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script type="module" src="~/js/game/main.js"></script>
}