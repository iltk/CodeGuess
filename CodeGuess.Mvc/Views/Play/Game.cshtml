@model PlayGameViewModel

<div id="game" data-join-code="@Model.JoinCode">

    <div id="lobby-section" class="tab-content">
        <h2>Lobby section</h2>
        <p>Waiting for host to start the game</p>
    </div>

    <div id="in-progress-section" class="tab-content" hidden>

        <div id="get-ready-view" class="round-view" hidden>
            <p>Get ready</p>
        </div>

        <div id="answering-view" class="round-view" hidden>
            <div id="option-list"></div>
        </div>

        <div id="submitted-view" class="round-view" hidden>
            <p id="submitted-answer"></p>
            <p>Answer locked in. Waiting for the timer...</p>
        </div>

        <div id="result-view" class="round-view" hidden>
            <p id="player-answer"></p>
            <p id="answer-result"></p>
            <p id="score"></p>
            <p id="place"></p>
        </div>

        <div id="time-up-view" class="round-view" hidden>
            <p>Time's up! Wait for the next question.</p>
        </div>

    </div>

    <div id="finished-section" class="tab-content" hidden>
        
        <h2>Result</h2>
        <p id="final-score"></p>
        <p id="final-place"></p>
    </div>


</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>
        const joinCode = "@Model.JoinCode";
        const playerId = "@Model.PlayerId";

        //  should match GameState enum in the API
        const GameState = { Lobby: 0, InProgress: 1, Finished: 2 };
        
        let answerRequest = null; // the answer being sent to the server
        let newestCallId = 0;     // id of the newest showCurrentGame call
        
        const sectionIds = {
            [GameState.Lobby]: "lobby-section",
            [GameState.InProgress]: "in-progress-section",
            [GameState.Finished]: "finished-section",
        };
        
        const optionList = document.getElementById("option-list");
        const submittedAnswerElement = document.getElementById("submitted-answer");
        const playerAnswerElement = document.getElementById("player-answer");
        const answerResultElement = document.getElementById("answer-result");
        const scoreElement = document.getElementById("score");
        const placeElement = document.getElementById("place");
        const finalScoreElement = document.getElementById("final-score");
        const finalPlaceElement = document.getElementById("final-place");

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("http://localhost:5129/hubs/game")
            .build();



        // showCurrentGame gets the details from the server and updates the ui
        connection.on("StateChanged", showCurrentGame);
        connection.on("QuestionStarted", showCurrentGame);
        connection.on("TimerStopped", showCurrentGame);


        
        // show the answer options and make one button per answer option
        function renderOptions(options) {
            optionList.innerHTML = ""; 

            options.forEach(option => {
                const button = document.createElement("button");
                button.type = "button";
                button.className = "btn btn-primary w-100 mb-2";
                button.textContent = option.text;
                button.addEventListener("click", () => submitAnswer(option));
                optionList.appendChild(button);
            });
        }

        function submitAnswer(option) {
            showSubmittedAnswer(option.text);
            answerRequest = sendAnswer(option.id);   //promise 
        }

        // show the player's answer screen while they wait for the timer
        function showSubmittedAnswer(text) {
            submittedAnswerElement.textContent = text;
            showRoundView("submitted-view");
        }

        // send the answer to the API
        async function sendAnswer(answerId) {
            try {
                const res = await fetch(`http://localhost:5129/api/Game/${joinCode}/answer`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ playerId, answerId })
                });

                if (!res.ok) console.error(res.status, await res.text());
            } catch (err) {
                console.error(err);
            }
        }
        
        //get player place and score
        async function getStat(){
            const res = await fetch(`http://localhost:5129/api/Game/${joinCode}/players/${playerId}/stat`);
            
            if (!res.ok) {
                const err = await res.json().catch(() => null);
                console.error(res.status, err);
                return null;
            }
            return await res.json();
        }

        // Fetch the player's score and place and show it
        async function showStats(scoreTarget, placeTarget) {
            const stat = await getStat();
            if (!stat) return;

            scoreTarget.textContent = `Your score is: ${stat.score}`;
            placeTarget.textContent = `Your place is: ${stat.place}`;
        }

        // Show green "Correct" or red "Incorrect" under the player's answer
        async function showAnswerResult(text, isCorrect) {
            showRoundView("result-view");

            const colorClass = isCorrect ? "text-success" : "text-danger";

            playerAnswerElement.textContent = text;
            playerAnswerElement.className = colorClass;
            answerResultElement.className = colorClass;
            answerResultElement.textContent = isCorrect ? "Correct" : "Incorrect";

            //clear last round's score, then show score and place
            scoreElement.textContent = "";
            placeElement.textContent = "";
            await showStats(scoreElement, placeElement);
        }

        // get game state from the server and render ui accoridngly
        async function showCurrentGame() {
            const callId = ++newestCallId;

            // if the player just answered, let it finish saving first, answerRequest is promise
            await answerRequest;

            const res = await fetch(`http://localhost:5129/api/Game/${joinCode}/players/${playerId}/game`);
            if (!res.ok) return;
            const game = await res.json();

            // a newer call started while this one was waiting, so this data is old
            if (callId !== newestCallId) return;

            if (game.state === GameState.Lobby) return showSection(GameState.Lobby);

            if (game.state === GameState.Finished) {
                showSection(GameState.Finished);
                return showStats(finalScoreElement, finalPlaceElement);
            }

            if (game.waitingForTimer) return showRoundView("get-ready-view");

            const picked = game.answerOptions.find(option => option.id === game.answerId);

            if (picked && game.isTimeUp) return showAnswerResult(picked.text, game.isCorrect);
            if (picked) return showSubmittedAnswer(picked.text);
            if (game.isTimeUp) return showRoundView("time-up-view");

            renderOptions(game.answerOptions);
            showRoundView("answering-view");
        }

        // hide every section, then show the one for this game state
        function showSection(state) {
            document.querySelectorAll(".tab-content").forEach(section => hide(section));
            show(document.getElementById(sectionIds[state]));
        }

        // show the in-progress section with only this view visible
        function showRoundView(viewId) {
            showSection(GameState.InProgress);
            document.querySelectorAll(".round-view").forEach(view => hide(view));
            show(document.getElementById(viewId));
        }

        function show(element) {
            element.hidden = false;
        }

        function hide(element) {
            element.hidden = true;
        }
        
        // Connect, join this room's group, then rebuild the page from the server
        connection.start()
            .then(async () => {
                await connection.invoke("JoinGame", joinCode);
                
                //handles user reload, restores previous page
                await showCurrentGame();
            })
            .catch(err => console.error(err));

        
    </script>
}
