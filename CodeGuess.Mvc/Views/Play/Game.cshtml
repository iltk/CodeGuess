@model PlayGameViewModel

<div id="game" data-join-code="@Model.JoinCode">

    <div id="lobby-section" class="tab-content d-block">
        <h2>Lobby section</h2>
        <p>Waiting for host to start the game</p>
    </div>

    <div id="question-section" class="tab-content d-none">
        
        <h2>Question section</h2>
        
        <div id="answer-form">
            <div id="option-list">
                
            </div>
            <button type="button" id="submit-answer">Submit</button>
        </div> 
        
        
    </div>
    
    <div id="get-ready-section" class="tab-content d-none">
        <p>Get ready</p>
    </div>

    <div id="correct-answer-section" class="tab-content d-none">
        
        <div id="answered-view" class="d-none">
            
            <p id="waiting-message" class="d-block">
                Waiting...
            </p>

            <p id="player-answer">

            </p>

            <p id="answer-result"></p>
            
            <p id="score"></p>
            <p id="place"></p>

        </div>
        
        <div id="time-up-view" class="d-block">
            <p>
                Too slow. Time ran out
                Wait for the next quastion
            </p>

        </div>

    </div>

    <div id="finished-section" class="tab-content d-none">
        
        <h2>Result</h2>
        <p id="final-score"></p>
        <p id="final-place"></p>
    </div>


</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>
        const joinCode = "@Model.JoinCode";
        const playerId = "@Model.PlayerId";
        let answerId;
        
        //  matc the GameState enum in the API
        const GameState = { Lobby: 0, InProgress: 1, Finished: 2 };
        const optionList = document.getElementById("option-list");
        
        let answerOptions;
        let currentGameState = GameState.Lobby;
        let playerAnswer;
        let hasSubmitted = false;
        let answerRequest = null;
        

        const sectionIds = {
            [GameState.Lobby]: "lobby-section",
            [GameState.InProgress]: "question-section",
            [GameState.Finished]: "finished-section",
        };
        
        
        const answeredView = document.getElementById("answered-view");
        const timeUpView = document.getElementById("time-up-view");
        const waitingMessage = document.getElementById("waiting-message");
        const playerAnswerElement = document.getElementById("player-answer");
        const answerResultElement = document.getElementById("answer-result");
        const scoreElement = document.getElementById("score");
        const placeElement = document.getElementById("place");
        const finalScoreElement = document.getElementById("final-score");
        const finalPlaceElement = document.getElementById("final-place");

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("http://localhost:5129/hubs/game")
            .build();



        // Server sends this when the host moves the game to a new state
        connection.on("StateChanged", state => {
            
            //player gets options in QuestionStarted
            if (state === GameState.InProgress) {
                showOnly("get-ready-section");
                return;
            }

            showSection(state);

            if (state === GameState.Finished) {
                showResult();
            }
        });

        // Server sends this when the host's timer starts
        connection.on("QuestionStarted", question => {
            resetAnswerView();                  
            renderOptions(question.options);   
            showSection(GameState.InProgress);   
           
        });

        // time is up,  show if the player was correct, or that they ran out of time
        connection.on("TimerStopped", async () => {
            showOnly("correct-answer-section");

            if (!hasSubmitted) {
                show(timeUpView);
                return;
            }
            
            const isCorrect = await answerRequest;
            if (isCorrect === null) {
                show(timeUpView);  
                return;
            }
            
            await showAnswerResult(isCorrect);
        });


        
        document.getElementById("submit-answer").addEventListener("click", async () => {
            //find the selected radio btn in the AnswerId group
            const selectedRadio = document.querySelector('input[name="AnswerId"]:checked');
            if (!selectedRadio) return;   

            answerId = selectedRadio.value;
            playerAnswer = findOptionText(Number(answerId));
            hasSubmitted = true;

            showOnly("correct-answer-section");
            showSubmittedAnswer();
            answerRequest = sendAnswer();
        });



        //hellpers 
        
        //get player leaderboard score
        //todo
       
        
        // Make one radio button per answer option
        function renderOptions(options) {
            answerOptions = options;
            optionList.innerHTML = ""; // clear the previous question's options

            options.forEach(option => {
                const label = document.createElement("label");
                label.innerHTML = `<input type="radio" name="AnswerId" value="${option.id}" required> `;
                label.append(option.text);
                optionList.appendChild(label);
                optionList.appendChild(document.createElement("br"));
            });
        }

        // Text of the answer option with this id
        function findOptionText(id) {
            const option = answerOptions.find(option => option.id === id);
            return option?.text || null;
        }

        // Show the player's answer with "Waiting for others to submit"
        function showSubmittedAnswer() {
            playerAnswerElement.textContent = `${playerAnswer}`;
            show(answeredView);
        }

        // Send the answer to the API returns true/false, or null if the call failed
        async function sendAnswer() {
            const payload = { playerId, answerId };

            const res = await fetch(`http://localhost:5129/api/Game/${joinCode}/answer`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },  
                body: JSON.stringify(payload)                      
            });

            if (!res.ok) {
                const err = await res.json().catch(() => null); 
                console.error(res.status, err);
                return null;
            }

            return await res.json();
        }
        
        
        async function getStat(){
            const res = await fetch(`http://localhost:5129/api/Game/${joinCode}/players/${playerId}/stat`);
            
            if (!res.ok) {
                const err = await res.json().catch(() => null);
                console.error(res.status, err);
                return null;
            }
            const stat = await res.json();
            
            console.log(stat.score, stat.place);
            return stat;
        }

        // Show green "Correct" or red "Incorrect" under the player's answer
        async function showAnswerResult(isCorrect) {
            show(answeredView);
            hide(waitingMessage); 

            const colorClass = isCorrect ? "text-success" : "text-danger";  

            playerAnswerElement.classList.add(colorClass);
            answerResultElement.classList.add(colorClass);
            answerResultElement.textContent = isCorrect ? "Correct" : "Incorrect";

            //show score and use place
            const stat = await getStat();

            scoreElement.textContent = `Your score is: ${stat.score}`;
            placeElement.textContent = `Your place is: ${stat.place}`;
        }

        // After a reload, ask the server for the game and rebuild the page
        async function restoreState() {
            const res = await fetch(`http://localhost:5129/api/Game/${joinCode}/players/${playerId}/restore`);
            if (!res.ok) return;

            const game = await res.json();

            if (game.state === GameState.Lobby) return;

            if (game.state === GameState.Finished) {
                showSection(GameState.Finished);
                await showResult();
                return;
            }

            if (game.waitingForTimer) {
                showOnly("get-ready-section");
                return;
            }

            resetAnswerView();
            const picked = game.answerOptions.find(option => option.id === game.answerId);

            if (picked) {
                // already answered, show their answer again
                playerAnswer = picked.text;
                hasSubmitted = true;
                answerRequest = game.isCorrect;
                showOnly("correct-answer-section");
                showSubmittedAnswer();

                if (game.isTimeUp) {
                    await showAnswerResult(game.isCorrect);
                }
            } else if (game.isTimeUp) {
                // time ran out and they didn't answer
                showOnly("correct-answer-section");
                show(timeUpView);
            } else {
                // question is still open
                renderOptions(game.answerOptions);
                showSection(GameState.InProgress);
            }
        }

        // Show the player's final score and place in the finished section
        async function showResult() {
            const stat = await getStat();
            if (!stat) return;

            finalScoreElement.textContent = `Your score is: ${stat.score}`;
            finalPlaceElement.textContent = `Your place is: ${stat.place}`;
        }

        // Put the answer views back to their starting state before the next question
        function resetAnswerView() {
            hasSubmitted = false;  
            answerId = null;
            answerRequest = null;

            hide(answeredView);
            hide(timeUpView);
            show(waitingMessage);

            playerAnswerElement.textContent = "";
            playerAnswerElement.classList.remove("text-success", "text-danger");

            answerResultElement.textContent = "";
            answerResultElement.classList.remove("text-success", "text-danger");

            scoreElement.textContent = "";
            placeElement.textContent = "";
            
            
        }

        // show the section  according to game state
        function showSection(state) {
            currentGameState = state;
            showOnly(sectionIds[state]);
        }

        // hide every section, then show the one with this id
        function showOnly(sectionId) {
            document.querySelectorAll(".tab-content").forEach(section => hide(section));

            const targetSection = document.getElementById(sectionId);
            if (targetSection) {
                show(targetSection);
            }
        }

        function show(element) {
            element.classList.remove("d-none");
            element.classList.add("d-block");
        }
        function hide(element) {
            element.classList.remove("d-block");
            element.classList.add("d-none");
        }
        
        // Connect, join this room's group, then rebuild the page from the server
        connection.start()
            .then(async () => {
                await connection.invoke("JoinGame", joinCode);
                
                //handles user reload, restores previous page
                await restoreState();
            })
            .catch(err => console.error(err));

        
    </script>
}
