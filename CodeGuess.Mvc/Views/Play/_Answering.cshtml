<div id="answering-view" class="round-view cg-scene cg-scene-wide" hidden>
    <div class="cg-answer-head">
        <div class="cg-row-label">
            <span><span id="question-label"></span>Read the big screen · pick an answer</span>
        </div>
    </div>

    <div id="answer-buttons" class="cg-options">
        <button type="button" class="cg-option cg-option-0"><span class="cg-option-letter">A</span><span class="cg-option-code">00</span></button>
        <button type="button" class="cg-option cg-option-1"><span class="cg-option-letter">B</span><span class="cg-option-code">01</span></button>
        <button type="button" class="cg-option cg-option-2"><span class="cg-option-letter">C</span><span class="cg-option-code">10</span></button>
        <button type="button" class="cg-option cg-option-3"><span class="cg-option-letter">D</span><span class="cg-option-code">11</span></button>
    </div>
</div>
