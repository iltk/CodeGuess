@model LeaderBoardViewModel

<main>
    <h1>@(Model.IsFinished ? "Result" : "LeaderBoard")</h1>

    <ul>
        @foreach (var player in Model.Players)
        {
            <li>@player.Nickname: @player.Score</li>
        }
    </ul>

    @if (Model.IsFinished)
    {
        <a asp-controller="Host" asp-action="Index">
            <button type="button">Back Home</button>
        </a>
    }
    else
    {
        <form asp-controller="Host" asp-action="Advance" method="post">
            <input type="hidden" name="joinCode" value="@Model.JoinCode" />
            <button type="submit">Next</button>
        </form>
    }
</main>
