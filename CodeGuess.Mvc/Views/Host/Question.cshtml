@model CodeGuess.Mvc.DTOs.GameResponse


<main>

    <p>Question @(Model.CurrentQuestionPosition + 1) / @Model.TotalQuestions</p>

    <h1>
        @(Model.Question?.Code ?? "No question found")
    </h1>

    @if (Model?.AnswerOptions != null)
    {

        <ul>
            @foreach (var answer in Model.AnswerOptions)
            {
                <li id="answer-@answer.Id">@(answer.Text ?? "Not Available")</li>
            }
        </ul>
    }
    else
    {
        <p>No questions found.</p>
    }
    <form id="next-form" asp-controller="Host" asp-action="Next" method="post">                                                                                                      
        <input type="hidden" name="joinCode" value="@Model.JoinCode" />                                                                                                                
    </form>     

    <p id="countdown">
        00:10
    </p>
</main>

@section Scripts {
    <script>
        const QUESTION_SECONDS = 10;
        const REVEAL_DELAY_MS = 5000;

        
        const leaderboardUrl = '@Html.Raw(Url.Action("LeaderBoard", "Host", new { joinCode = Model.JoinCode }))';
        const joinCode = '@Model.JoinCode';
        const questionId = @(Model.Question?.Id ?? 0);
        const currentQuestionPosition = @Model.CurrentQuestionPosition;
        const totalQuestions = @Model.TotalQuestions;
        const isLastQuestion = currentQuestionPosition + 1 >= totalQuestions;
        const countdownElement = document.getElementById("countdown");
        let secondsLeft = QUESTION_SECONDS;
        

        // TODO: for now use fetch, may switch to SignalR when player functionality is added
        const correctAnswerIdPromise = fetch(`http://localhost:5129/api/Game/${joinCode}/correct-answer?questionId=${questionId}`)
            .then(response => {
                if (!response.ok) throw new Error(response.status); // fetch doesn't throw on 404/500
                return response.json();
            })
            .catch(error => {
                console.error("Failed to load correct answer:", error);
                return null;
            });

        

        function delay(ms) {
            return new Promise(resolve => setTimeout(resolve, ms));
        }
        
        function revealCorrectAnswer(correctAnswerId) {
            const correctAnswerElement = document.getElementById(`answer-${correctAnswerId}`);
            if (correctAnswerElement) {
                correctAnswerElement.textContent += " ✔ correct";
            }
        }
        
        const countdownTimerId = setInterval(async () => {
            secondsLeft--;
            countdownElement.textContent = `00:${secondsLeft}`;

            if (secondsLeft === 0) {
                clearInterval(countdownTimerId);

                revealCorrectAnswer(await correctAnswerIdPromise);

                // Wait before going to the leaderboard page
                await delay(REVEAL_DELAY_MS);
                
                if (isLastQuestion) {
                    // Server sets Finished and redirects to LeaderBoard
                    document.getElementById("next-form").submit();
                } else {
                    window.location.href = leaderboardUrl;
                }
            }
        }, 1000);
        
    </script>
}




