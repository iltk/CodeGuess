@model HostRoundViewModel
@{
    ViewData["HideRain"] = true;
    var letters = "ABCD";
}

<main class="cg-round">

    <div class="cg-round-head">
        <div>
            <p class="cg-round-kicker">Question @(Model.CurrentQuestionPosition + 1) / @Model.TotalQuestions</p>
            <h1 class="cg-round-title">Which project is this from?</h1>
        </div>
        <p id="countdown" class="cg-round-timer" role="timer">00:10</p>
    </div>

    <!-- Code snippet -->
    <section class="cg-snippet" aria-label="Code snippet">
        <div class="cg-snippet-bar">
            <span>Snippet @(Model.CurrentQuestionPosition + 1)</span>
        </div>
        <pre><code>@(Model.Code ?? "No question found")</code></pre>
    </section>

    @if (Model.AnswerOptions.Count > 0)
    {
        <ul class="cg-round-options">
            @for (var i = 0; i < Model.AnswerOptions.Count; i++)
            {
                var answer = Model.AnswerOptions[i];
                <li id="answer-@answer.Id" class="cg-round-option cg-option-@(i % 4)">
                    <span class="cg-round-letter">@letters[i % 4]</span>
                    <span class="cg-round-text">@(answer.Text ?? "Not Available")</span>
                </li>
            }
        </ul>
    }
    else
    {
        <p>No questions found.</p>
    }

    <form id="advance-form" asp-controller="Host" asp-action="Advance" method="post">
        <input type="hidden" name="joinCode" value="@Model.JoinCode" />
    </form>

</main>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>

        const joinCode = '@Model.JoinCode';
        const leaderboardUrl = '@Html.Raw(Url.Action("LeaderBoard", "Host", new { joinCode = Model.JoinCode }))';

        const currentQuestionPosition = @Model.CurrentQuestionPosition;
        const totalQuestions = @Model.TotalQuestions;
        const isLastQuestion = currentQuestionPosition + 1 >= totalQuestions;

        const countdownElement = document.getElementById("countdown");

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("http://localhost:5129/hubs/game")
            .build();

        // timer started, count down every second
        connection.on("TimerStarted", seconds => {

            const intervalId = setInterval(() => {
                seconds--;
                countdownElement.textContent = `00:${String(seconds)}`;
                if (seconds <= 0) clearInterval(intervalId);
            }, 1000);
        });

        // time is up, reveal the answer, then move on after 8 s to leaderboard
        connection.on("TimerStopped", async () => {
            await showCorrectAnswer();
            setTimeout(goToNextScreen, 8000);
        });

        // fetch correct answer and marks it in the list
        async function showCorrectAnswer() {
            const response = await fetch(`http://localhost:5129/api/Game/${joinCode}/correct-answer`);
            const correctAnswerId = await response.json();

            const correctAnswerElement = document.getElementById(`answer-${correctAnswerId}`);
            if (correctAnswerElement) {
                document.querySelector(".cg-round").classList.add("is-reveal");   // changed
                correctAnswerElement.classList.add("is-correct");                 // changed
            }
        }

        // After the last question finish the game, otherwise show the leaderboard
        function goToNextScreen() {
            if (isLastQuestion) {
                // Server sets Finished and redirects to LeaderBoard
                document.getElementById("advance-form").submit();
            } else {
                window.location.href = leaderboardUrl;
            }
        }

        // connect, join this game's group, then start the question timer
        connection.start()
            .then(async () => {
                await connection.invoke("JoinGame", joinCode);
                await connection.invoke("StartTimer", joinCode);
            })
            .catch(err => console.error(err));
    </script>
}