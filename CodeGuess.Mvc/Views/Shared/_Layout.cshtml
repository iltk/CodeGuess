@{
    var showRain = ViewData["HideRain"] as bool? != true;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CodeGuess</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CodeGuess.Mvc.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
<div class="row g-0 flex-grow-1">
    @if (showRain)
    {
        <partial name="_BinaryRain" model="@("left")" />
    }

    <div class="col-12 col-lg d-flex flex-column cg-page">
        <header class="cg-header">
            <a class="cg-header-logo" asp-controller="Play" asp-action="Index">{?}</a>
            <a class="cg-header-link" asp-controller="Host" asp-action="Index">Host a game</a>
        </header>

        <main class="flex-grow-1 d-flex flex-column">
            @RenderBody()
        </main>

        <footer class="cg-footer">
            <span>CodeGuess</span>
            <span>A live code quiz</span>
        </footer>
    </div>

    @if (showRain)
    {
        <partial name="_BinaryRain" model="@("right")" />
    }
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/gsap.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>